# ====================================================================
# Reka Creative Labs - Environment Variables Configuration
# ====================================================================

# Port for local Node.js server
PORT=5000

# --------------------------------------------------------------------
# Cashfree Payment Gateway Credentials
# NOTE: Never commit production secret keys to Git.
# Set CASHFREE_ENV to "TEST" for sandbox testing, "PROD" for production.
# --------------------------------------------------------------------
CASHFREE_ENV=TEST
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID_HERE
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY_HERE

# --------------------------------------------------------------------
# Webinar & Meeting Links
# --------------------------------------------------------------------
ZOOM_LINK=https://us02web.zoom.us/j/rekacreativelabs
CALENDLY_URL=https://calendly.com/rekacreativelabs/30min

# --------------------------------------------------------------------
# Meta Pixel & Analytics
# --------------------------------------------------------------------
META_PIXEL_ID=1095990819739700

# --------------------------------------------------------------------
# Email Notification (Gmail SMTP / Nodemailer)
# --------------------------------------------------------------------
EMAIL_USER=rekacreativelabs@gmail.com
EMAIL_PASS=YOUR_16_CHAR_GMAIL_APP_PASSWORD_HERE
